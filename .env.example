# ─────────────────────────────────────────────────────────────────────────────
# Hush — private one-to-one AI chat
# Copy this file to `.env` for local development. On a hosting provider, add
# the same variables in the project's Environment Variables settings.
# Never commit real keys and never prefix them with NEXT_PUBLIC_ (that would
# expose them to the browser).
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection (only used when CHAT_HISTORY_ENABLED=true, but required
# for the app to boot and for the /api/health check).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── AI provider (set ONE of these; the server picks whichever is present) ────
# Google Gemini — Google AI Studio key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6JdC7lF_9DO8v4qNvnbXD2IGILLGGSf7GKB8MIgHUP5Gw
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: force a provider when several keys are present ("gemini" | "openai" | "anthropic")
# AI_PROVIDER=gemini

# Optional: model override. Use the PLAIN model ID exactly as the provider lists it.
#   Gemini    → gemini-3.8-flash (server picks the best available if unset)
#   OpenAI    → gpt-4.1-mini (default), gpt-4.1
#   Anthropic → claude-haiku-4-5 (default), claude-sonnet-4-5
# ⚠ For Gemini do NOT write "models/gemini-…" or "google/gemini-…" — that causes
#   "GenerateContentRequest.model: unexpected model name format". (Hush now strips
#   such prefixes automatically, but keep it plain.)
# AI_MODEL=gemini-3.8-flash

# Optional: use any OpenAI-compatible API (Groq, Mistral, OpenRouter, Ollama, …)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_BASE_URL=http://localhost:11434/v1        # Ollama (OPENAI_API_KEY can be any non-empty string)
# Note: pointing OPENAI_BASE_URL at generativelanguage.googleapis.com makes Hush
# use the native Gemini API with OPENAI_API_KEY as the Gemini key.

# Optional: custom assistant personality
# AI_SYSTEM_PROMPT=You are a friendly, concise assistant.

# ── Privacy / history ────────────────────────────────────────────────────────
# false (default): nothing is stored on the server; chats live in the visitor's browser tab.
# true: visitors must sign in; each account sees only its own saved conversations.
CHAT_HISTORY_ENABLED=false

# ── Abuse protection & limits (optional) ─────────────────────────────────────
# CHAT_RATE_LIMIT_PER_MINUTE=20
# CHAT_MAX_MESSAGE_CHARS=4000
# CHAT_MAX_CONTEXT_MESSAGES=30
